---
interface Props {
  id: string;
  name?: string;
  label: string;
  autocomplete?: string;
  autofocus?: boolean;
  minlength?: number;
  required?: boolean;
}
const {
  id,
  name = id,
  label,
  autocomplete = 'current-password',
  autofocus = false,
  minlength,
  required = true,
} = Astro.props;
---
<label for={id}>{label}</label>
<div class="pw-wrap">
  <input
    id={id}
    name={name}
    type="password"
    autocomplete={autocomplete}
    required={required}
    autofocus={autofocus}
    minlength={minlength}
  />
  <button type="button" class="pw-toggle" data-for={id} aria-label="Passwort anzeigen" aria-pressed="false">
    <svg class="icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12S6 6.5 12 6.5 21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.6"/></svg>
    <svg class="icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M3 3l18 18"/><path d="M9.9 9.9A3 3 0 0 0 12 15a3 3 0 0 0 2.1-.9"/><path d="M6.5 7.2C4.5 8.5 3 10.4 2.5 12 4 15.5 7.6 17.5 12 17.5c1.2 0 2.3-.2 3.3-.5"/><path d="M17.6 15.3c1.7-1.2 3-3 3.4-3.3-1.5-3.5-5.1-5.5-9.5-5.5-.8 0-1.6.1-2.3.2"/></svg>
  </button>
</div>

<style>
  label { font-weight: 600; font-size: .95rem; }
  .pw-wrap { position: relative; display: grid; }
  .pw-wrap input { font: inherit; padding: .75rem 2.7rem .75rem .85rem; border: 1px solid #c5cdc8; border-radius: 10px; width: 100%; box-sizing: border-box; }
  .pw-wrap input:focus { outline: 2px solid var(--forest, #0f3b33); outline-offset: 1px; }
  .pw-toggle { position: absolute; right: .25rem; top: 50%; transform: translateY(-50%); width: 2.2rem; height: 2.2rem; border: 0; background: transparent; color: #4a5b56; cursor: pointer; display: grid; place-items: center; border-radius: 8px; }
  .pw-toggle:hover { background: #F2F5F3; color: #0f3b33; }
</style>

<script is:inline>
  (function () {
    if (window.__sbPwToggle) return;
    window.__sbPwToggle = true;
    document.addEventListener('click', function (ev) {
      var btn = ev.target.closest && ev.target.closest('.pw-toggle');
      if (!btn) return;
      var id = btn.getAttribute('data-for');
      var input = id ? document.getElementById(id) : null;
      if (!input) return;
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.setAttribute('aria-pressed', show ? 'true' : 'false');
      btn.setAttribute('aria-label', show ? 'Passwort verbergen' : 'Passwort anzeigen');
      var on = btn.querySelector('.icon-show');
      var off = btn.querySelector('.icon-hide');
      if (on && off) {
        on.style.display = show ? 'none' : '';
        off.style.display = show ? '' : 'none';
      }
    });
  })();
</script>
