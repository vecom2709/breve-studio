---
import Mark from './Mark.astro';
import type { Locale } from '../content/packages';
import { path, ui } from '../lib/i18n';
interface Props { lang: Locale; theme?: 'dark' | 'light' }
const { lang, theme = 'light' } = Astro.props;
---
<a class:list={['wordmark', theme]} href={path('home', lang)} aria-label={lang === 'de' ? 'Studio Breve – Startseite' : 'Studio Breve – home'}>
  <Mark size={40} />
  <span class="wm-col">
    <span class="wm-text">Studio <em>Breve</em></span>
    <span class="wm-tag">{ui[lang].taglineSmall}</span>
  </span>
</a>
<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--ink); }
  .wm-col { display: grid; gap: 0.15rem; line-height: 1; }
  .wm-text { font-family: var(--serif); font-size: 1.28rem; letter-spacing: -0.01em; font-weight: 460; }
  .wm-text em { font-style: italic; font-weight: 420; }
  .wm-tag { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .wordmark.light .wm-text em { color: var(--forest-mid); }
  .wordmark.dark { color: #F6F1E8; }
  .wordmark.dark .wm-tag { color: var(--mint-dim); }
  .wordmark.dark:hover, .wordmark.light:hover { color: inherit; }
  @media (max-width: 32rem) {
    .wm-tag { display: none; }
    .wm-text { font-size: 1.15rem; }
  }
</style>
