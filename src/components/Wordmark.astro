---
/** Logo „Studio Breve“ mit goldenem V. `dark` = helle Schrift für dunkle Flächen, `light` = dunkle Schrift für helle Flächen. */
import type { Locale } from '../content/packages';
import { path } from '../lib/i18n';
interface Props { lang: Locale; theme?: 'dark' | 'light'; width?: number; link?: boolean }
const { lang, theme = 'light', width = 180, link = true } = Astro.props;
const datei = theme === 'dark' ? 'logo-studio-breve-gold' : 'logo-studio-breve-gold-hell';
const hoehe = Math.round((width * 372) / 1223);
const Tag = link ? 'a' : 'span';
---
<Tag class:list={['wordmark', theme]} href={link ? path('home', lang) : undefined} aria-label={link ? (lang === 'de' ? 'Studio Breve – Startseite' : 'Studio Breve – home') : undefined}>
  <picture>
    <source type="image/webp" srcset={`/${datei}-240.webp 240w, /${datei}-480.webp 480w, /${datei}-720.webp 720w`} sizes={`${width}px`} />
    <img src={`/${datei}-480.png`} width={width} height={hoehe} alt="Studio Breve" decoding="async" />
  </picture>
</Tag>
<style>
  .wordmark { display: inline-block; line-height: 0; border-radius: 6px; text-decoration: none; }
  .wordmark img { height: auto; }
  .wordmark:focus-visible { box-shadow: 0 0 0 3px var(--gold); }
</style>
