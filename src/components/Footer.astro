---
import { apiBasis, mitApi } from '../lib/server-api';
import Wordmark from './Wordmark.astro';
import { site } from '../content/site';
import { categories, type Locale } from '../content/packages';
import { path, ui, chooserHref } from '../lib/i18n';
interface Props { lang: Locale; alternates: { lang: Locale; href: string }[] }
const { lang, alternates } = Astro.props;
const t = ui[lang];
const op = site.operator;
/** Knopf zum Ändern der IP-Einwilligung – nur, wo die Messung (Tracker) läuft */
const mitEinwilligung = mitApi;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div class="col brand">
        <Wordmark lang={lang} theme="light" />
        <p class="tag">{site.tagline[lang]}</p>
        <address>
          {op.name}<br />
          {op.street}<br />
          {op.postalCode} {op.city} ({op.province}), {op.country[lang]}<br />
          <a href={op.phoneHref}>{op.phone}</a><br />
          <span>{op.email}</span> <span class="muted small">({lang === 'de' ? 'Platzhalter' : 'provvisorio'})</span>
        </address>
      </div>
      <nav class="col" aria-label={t.nav.packages}>
        <p class="h">{t.nav.packages}</p>
        <ul>
          {categories.map((c) => <li><a href={`${path('packages', lang)}?k=${c.id}`}>{c.label[lang]}</a></li>)}
          <li><a href={path('packages', lang)}>{t.allPackages}</a></li>
          <li><a href={path('products', lang)}>{t.nav.products}</a></li>
          <li><a href={path('services', lang)}>{t.nav.services}</a></li>
        </ul>
      </nav>
      <nav class="col" aria-label="Studio Breve">
        <p class="h">Studio Breve</p>
        <ul>
          <li><a href={path('about', lang)}>{t.nav.about}</a></li>
          <li><a href={path('contact', lang)}>{t.nav.contact}</a></li>
          <li><a href={path('cart', lang)}>{t.cart}</a></li>
        </ul>
        <p class="h h2">{lang === 'de' ? 'Rechtliches' : 'Informazioni legali'}</p>
        <ul>
          <li><a href={path('imprint', lang)}>{t.legal.imprint}</a></li>
          <li><a href={path('privacy', lang)}>{t.legal.privacy}</a></li>
          <li><a href={path('terms', lang)}>{t.legal.terms}</a></li>
        </ul>
      </nav>
      <div class="col">
        <p class="h">{lang === 'de' ? 'Sprache' : 'Lingua'}</p>
        <ul>
          <li><span aria-current="true" class="cur">{t.langName}</span></li>
          {alternates.map((a) => (
            <li><a href={a.href} hreflang={a.lang} lang={a.lang}>{ui[a.lang].langName}</a></li>
          ))}
          <li><a href={chooserHref}>{t.chooseLanguage}</a></li>
        </ul>
        <p class="visits small" data-visit-count-wrap>
          <span data-visit-phrase>{t.visitsSince}</span>
        </p>
        <p class="small muted note">{lang === 'de'
          ? 'Diese Website setzt keine Tracking-Cookies.'
          : 'Questo sito non usa cookie di tracciamento.'}
          {mitEinwilligung && <> <button type="button" class="einst" data-sb-einwilligung>{lang === 'de' ? 'Datenschutz-Einstellungen' : 'Impostazioni privacy'}</button></>}</p>
      </div>
    </div>
    <div class="base small">
      <span>© 2026 Studio Breve · {op.name} · P.IVA {op.vatId[lang]}</span>
      <a class="admin-link" href={apiBasis ? `${apiBasis}/` : '/verwaltung/'} rel="nofollow">{t.adminArea}</a>
      <span>{lang === 'de' ? 'Preise sind Listenpreise; ein Vertrag kommt über diese Seite nicht zustande.' : 'I prezzi sono di listino; tramite questo sito non si conclude alcun contratto.'}</span>
    </div>
  </div>
</footer>
<style>
  .site-footer { margin-top: 0; border-top: 1px solid var(--line); background: var(--paper-2); padding-block: var(--space-l) var(--space-m); }
  .draft { border: 1px dashed var(--line-strong); border-radius: var(--radius); padding: 0.85rem 1.1rem; font-size: var(--step--1); color: var(--ink-2); background: var(--paper); }
  .cols { display: grid; gap: 2rem; padding-block: var(--space-l); }
  @media (min-width: 44rem) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) { .cols { grid-template-columns: 1.5fr 1fr 1fr 1fr; } }
  .tag { margin-top: 1rem; font-family: var(--serif); font-style: italic; color: var(--ink-2); max-width: 22em; }
  address { font-style: normal; margin-top: 1.2rem; font-size: var(--step--1); line-height: 1.7; color: var(--ink-2); }
  .h { font-size: var(--step--1); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: .7rem; }
  .h2 { margin-top: 1.6rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  .col a { text-decoration: none; color: var(--ink); }
  .col a:hover { color: var(--forest-mid); text-decoration: underline; }
  .cur { font-weight: 600; }
  .note { margin-top: 0.8rem; }
  .einst { display: inline; padding: 0; border: 0; background: none; font: inherit; color: var(--forest); font-weight: 600; text-decoration: underline; text-underline-offset: 0.18em; cursor: pointer; min-height: 24px; }
  .einst:hover { color: var(--forest-mid); }
  .einst:focus-visible { outline: 3px solid var(--gold-deep); outline-offset: 2px; border-radius: 2px; }
  .visits { margin-top: 1.1rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem 2rem; border-top: 1px solid var(--line); padding-top: 1rem; color: var(--muted); }
  .admin-link { color: var(--forest); font-weight: 600; text-decoration: underline; text-underline-offset: 0.18em; }
  .admin-link:hover { color: var(--forest-mid); }
</style>
