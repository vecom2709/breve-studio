---
/** Eigenes Zeichen von Studio Breve: typografisches Breve über den Buchstaben S und B. */
interface Props { size?: number; class?: string; framed?: boolean }
const { size = 36, class: cls, framed = false } = Astro.props;
const uid = 'sb' + Math.random().toString(36).slice(2, 8);
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${uid}-g`} x1="8" y1="2" x2="58" y2="62" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#F7E7B0"/>
      <stop offset="0.22" stop-color="#E8C45C"/>
      <stop offset="0.55" stop-color="#C9962E"/>
      <stop offset="0.82" stop-color="#A8751C"/>
      <stop offset="1" stop-color="#7A5412"/>
    </linearGradient>
    <linearGradient id={`${uid}-s`} x1="16" y1="16" x2="50" y2="60" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#FFF1C4"/>
      <stop offset="0.45" stop-color="#D7AB3E"/>
      <stop offset="1" stop-color="#8D6418"/>
    </linearGradient>
  </defs>
  {framed && <rect width="64" height="64" rx="14" fill="#0f3b33" />}
  <path d="M10 20C22 7.5 42 7.5 54 20" stroke={`url(#${uid}-g)`} stroke-width="5.2" stroke-linecap="round" fill="none"/>
  <path fill={`url(#${uid}-s)`} d="M28.2 28.6c0-5.2-3.9-8.4-10.4-8.4c-6.6 0-10.6 3.4-11.3 8.3h6.15c.45-2.15 2.15-3.45 5.15-3.45c2.7 0 4.15 1.2 4.15 3.05c0 1.7-1.05 2.55-4.7 3.55c-5.35 1.5-8.55 3.7-8.55 8.35c0 5.15 4.05 8.35 10.7 8.35c6.85 0 11.05-3.5 11.6-8.85h-6.2c-.5 2.35-2.55 3.85-5.5 3.85c-2.85 0-4.45-1.3-4.45-3.25c0-1.7 1.15-2.65 4.95-3.7c5.45-1.5 8.75-3.85 8.75-8.81z"/>
  <path fill={`url(#${uid}-g)`} d="M33 20.8 h7.1c7.6 0 12.15 3.7 12.15 9.45c0 3.85-2.05 6.5-5.55 7.55c4.35 1.05 7.15 4.2 7.15 8.7c0 6.35-5.15 10.3-13.35 10.3H33 z M39.35 26.15v7.85 h2.35c2.95 0 4.7-1.45 4.7-3.95c0-2.45-1.7-3.9-4.7-3.9 z M39.35 38.55v8.95 h3.05c3.35 0 5.35-1.7 5.35-4.5c0-2.75-2-4.45-5.35-4.45 z"/>
</svg>
