---
import Wordmark from './Wordmark.astro';
import type { Locale } from '../content/packages';
import { path, ui, switchToLabel, type RouteKey } from '../lib/i18n';
interface Props {
  lang: Locale;
  routeKey: RouteKey;
  alternates: { lang: Locale; href: string }[];
}
const { lang, routeKey, alternates } = Astro.props;
const t = ui[lang];
const items: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.nav.home },
  { key: 'products', label: t.nav.products },
  { key: 'packages', label: t.nav.packages },
  { key: 'about', label: t.nav.about },
  { key: 'contact', label: t.nav.contact },
];
const isCurrent = (k: RouteKey) =>
  k === routeKey ||
  (k === 'packages' && routeKey === 'package') ||
  (k === 'contact' && routeKey === 'thanks');
---
<header class="site-header">
  <div class="wrap bar">
    <Wordmark lang={lang} theme="light" />
    <nav class="nav-desktop" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Navigazione principale'}>
      <ul>
        {items.map((i) => (
          <li>
            <a class:list={['nav-link', { on: isCurrent(i.key) }]} href={path(i.key, lang)} aria-current={isCurrent(i.key) ? 'page' : undefined}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <p class="visit-pill" data-visit-pill>
        <svg class="eye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12S6 6.5 12 6.5 21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.6"/></svg>
        <span data-visit-phrase>{t.visitsSince}</span>
      </p>
      <button type="button" class="icon-btn" data-open-search aria-controls="suche" aria-expanded="false" aria-label={t.search}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 5 5"/></svg>
      </button>
      <div class="lang" role="group" aria-label={lang === 'de' ? 'Sprache' : 'Lingua'}>
        <details>
          <summary><span>{t.langShort}</span></summary>
          <ul>
            <li><span aria-current="true">{t.langName}</span></li>
            {alternates.map((a) => (
              <li><a href={a.href} hreflang={a.lang} lang={a.lang}>{ui[a.lang].langName}</a></li>
            ))}
          </ul>
        </details>
      </div>
      <a class="icon-btn cart" href={path('cart', lang)} aria-label={t.cartEmptyBadge}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h2l2.2 11h9.6L20 8H7"/><circle cx="10" cy="19" r="1.3"/><circle cx="17" cy="19" r="1.3"/></svg>
        <span class="badge" aria-hidden="true">0</span>
      </a>
      <details class="nav-mobile">
        <summary><span class="sum-open">{t.menu}</span><span class="sum-close">{t.close}</span></summary>
        <div class="sheet">
          <ul>
            {items.map((i) => (
              <li><a href={path(i.key, lang)} aria-current={isCurrent(i.key) ? 'page' : undefined}>{i.label}</a></li>
            ))}
          </ul>
          {alternates.map((a) => (
            <a class="lang-m" href={a.href} hreflang={a.lang} lang={a.lang} aria-label={switchToLabel(lang, a.lang)}>{ui[a.lang].langName}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 30; background: #fff; color: var(--ink); border-bottom: 1px solid #E6E8E4; }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 4.4rem; }
  .nav-desktop { display: none; flex: 1; justify-content: center; }
  .nav-desktop ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.15rem 1.5rem; list-style: none; margin: 0; padding: 0; }
  .nav-link { text-decoration: none; color: var(--ink-2); font-weight: 600; font-size: 0.95rem; padding: 0.35rem 0; border-bottom: 2px solid transparent; }
  .nav-link:hover { color: var(--forest); }
  .nav-link.on, .nav-link[aria-current='page'] { color: var(--forest); border-bottom-color: var(--forest); }
  .tools { display: flex; align-items: center; gap: 0.35rem; margin-left: auto; }
  .visit-pill { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0; padding: 0.35rem 0.7rem; border-radius: 999px; background: #E7F0EC; color: var(--forest); font-weight: 650; font-size: 0.8rem; line-height: 1.2; letter-spacing: 0; font-variant-numeric: tabular-nums; white-space: nowrap; max-width: 16rem; }
  .visit-pill .eye { flex-shrink: 0; }
  .visit-pill [data-visit-phrase] { overflow: hidden; text-overflow: ellipsis; }
  .icon-btn { appearance: none; background: none; border: 0; color: var(--ink); width: 2.5rem; height: 2.5rem; display: inline-grid; place-items: center; cursor: pointer; border-radius: 999px; text-decoration: none; position: relative; }
  .icon-btn:hover { color: var(--forest); background: #F2F5F3; }
  .cart .badge { position: absolute; top: 0.2rem; right: 0.15rem; min-width: 1.05rem; height: 1.05rem; padding: 0 0.22rem; border-radius: 999px; background: var(--forest); color: #fff; font-size: 0.65rem; font-weight: 700; display: grid; place-items: center; }
  .lang details { position: relative; }
  .lang summary { list-style: none; cursor: pointer; font-weight: 700; font-size: 0.8rem; letter-spacing: .04em; padding: 0.4rem 0.75rem; border: 1px solid #D5DAD6; border-radius: 999px; }
  .lang summary::-webkit-details-marker { display: none; }
  .lang summary span::after { content: ' ▾'; font-weight: 500; }
  .lang ul { position: absolute; right: 0; top: calc(100% + 0.4rem); background: #fff; border: 1px solid #E6E8E4; border-radius: 10px; list-style: none; margin: 0; padding: .4rem; min-width: 10rem; box-shadow: 0 8px 24px rgba(15,59,51,.08); }
  .lang li { margin: 0; }
  .lang a, .lang li span { display: block; padding: .45rem .7rem; border-radius: 8px; text-decoration: none; color: var(--ink); font-weight: 600; }
  .lang a:hover { background: #F2F5F3; }
  .lang [aria-current='true'] { color: var(--forest); }
  .nav-mobile summary { list-style: none; cursor: pointer; font-weight: 600; padding: 0.45rem 0.85rem; border: 1px solid #D5DAD6; border-radius: 999px; font-size: var(--step--1); }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile .sum-close { display: none; }
  .nav-mobile[open] .sum-open { display: none; }
  .nav-mobile[open] .sum-close { display: inline; }
  .sheet { position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-bottom: 1px solid #E6E8E4; padding: 1rem 1.25rem 1.5rem; }
  .sheet ul { list-style: none; margin: 0; padding: 0; }
  .sheet li a { display: block; padding: 0.8rem 0; border-bottom: 1px solid #E6E8E4; text-decoration: none; font-family: var(--geo); font-size: var(--step-2); color: var(--ink); }
  .sheet a[aria-current='page'] { color: var(--forest); }
  .lang-m { display: inline-block; margin-top: 1rem; font-weight: 600; color: var(--forest); }
  @media (max-width: 63.99rem) {
    .bar { flex-wrap: wrap; }
    .visit-pill { flex: 1 0 100%; order: 5; justify-content: center; max-width: none; margin: 0 0 0.65rem; }
  }
  @media (min-width: 64rem) {
    .nav-desktop { display: flex; }
    .nav-mobile { display: none; }
  }
</style>
