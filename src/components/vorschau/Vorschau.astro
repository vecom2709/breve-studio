---
/**
 * Kleine, klickbare Vorschau je Paket: zeigt dem Kunden mit erfundenen Beispieldaten, worum es geht.
 * Ohne JavaScript – Sprachwahl und Zeitwahl laufen über beschriftete Radio-Felder.
 */
import type { Locale, VorschauDaten } from '../../content/packages';
import { vorschauSlugs } from './liste';
interface Props { slug: string; lang: Locale; daten?: VorschauDaten }
const { slug, lang, daten } = Astro.props;
const generisch = !vorschauSlugs.has(slug) && daten;
const de = lang === 'de';
const id = `vs-${slug}`;

// MenuVivo: dieselben Gerichte in drei Sprachen
const karte = {
  de: { titel: 'Speisekarte', tag: 'Tagesgericht', gerichte: [
    ['Arancini al ragù', 'Reisbällchen mit Ragù, frittiert', '6,50', ['1', '3', '7']],
    ['Pasta alla Norma', 'Aubergine, Tomate, gesalzener Ricotta', '11,00', ['1', '7']],
    ['Cannolo siciliano', 'Ricotta, Pistazie, kandierte Orange', '4,50', ['1', '7', '8']],
  ] },
  it: { titel: 'Menù', tag: 'Piatto del giorno', gerichte: [
    ['Arancini al ragù', 'Riso, ragù di carne, fritti', '6,50', ['1', '3', '7']],
    ['Pasta alla Norma', 'Melanzane, pomodoro, ricotta salata', '11,00', ['1', '7']],
    ['Cannolo siciliano', 'Ricotta, pistacchio, arancia candita', '4,50', ['1', '7', '8']],
  ] },
  en: { titel: 'Menu', tag: 'Dish of the day', gerichte: [
    ['Arancini al ragù', 'Fried rice balls with meat ragù', '6.50', ['1', '3', '7']],
    ['Pasta alla Norma', 'Aubergine, tomato, salted ricotta', '11.00', ['1', '7']],
    ['Cannolo siciliano', 'Ricotta, pistachio, candied orange', '4.50', ['1', '7', '8']],
  ] },
} as const;
const allergene: Record<string, string> = de
  ? { '1': 'Gluten', '3': 'Ei', '7': 'Milch', '8': 'Schalenfrüchte' }
  : { '1': 'Glutine', '3': 'Uova', '7': 'Latte', '8': 'Frutta a guscio' };

const tage = de ? ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'] : ['Lu', 'Ma', 'Me', 'Gi', 'Ve', 'Sa'];
const zeiten = ['09:00', '09:45', '10:30', '11:15', '14:00', '14:45', '15:30', '16:15'];
const belegt = new Set(['09:45', '11:15', '15:30']);
---
<div class="vs-huelle">
<div class:list={['vs', `vs-${slug}`]} role="group" aria-label={de ? 'Beispielansicht mit erfundenen Daten' : 'Anteprima con dati di esempio'}>
  <span class="vs-marke">{de ? 'Beispielansicht' : 'Anteprima'}</span>

  {slug === 'menuvivo' && (
    <div class="vs-buehne">
      <div class="handy">
        <div class="handy-insel"></div>
        <div class="mv">
          {(['de', 'it', 'en'] as const).map((s, i) => (
            <input type="radio" name={`${id}-sprache`} id={`${id}-${s}`} class="mv-r" checked={(lang === 'it' ? 1 : 0) === i} />
          ))}
          <div class="mv-kopf">
            <strong>Trattoria Esempio</strong>
            <div class="mv-tabs">
              {(['de', 'it', 'en'] as const).map((s) => <label for={`${id}-${s}`} class={`mv-t mv-t-${s}`}>{s.toUpperCase()}</label>)}
            </div>
          </div>
          {(['de', 'it', 'en'] as const).map((s) => (
            <div class={`mv-liste mv-l-${s}`}>
              <p class="mv-h">{karte[s].titel}</p>
              {karte[s].gerichte.map(([n, b, p, a], i) => (
                <div class="mv-g">
                  <div><span class="mv-n">{n}</span>{i === 1 && <em class="mv-tag">{karte[s].tag}</em>}<span class="mv-b">{b}</span>
                    <span class="mv-a">{a.map((x) => <i title={allergene[x]}>{x}</i>)}</span></div>
                  <span class="mv-p">{p} €</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="vs-seite">
        <div class="aufsteller">
          <img class="qr-deko" src="/images/vorschau/qr-beispiel.svg" alt="" width="120" height="120" />
          <strong>{de ? 'Speisekarte scannen' : 'Inquadra il menù'}</strong>
          <span>DE · IT · EN</span>
        </div>
        <ul class="legende">
          {Object.entries(allergene).map(([k, v]) => <li><i>{k}</i>{v}</li>)}
        </ul>
      </div>
    </div>
  )}

  {slug === 'mappaviva' && (
    <div class="vs-buehne mp">
      <div class="karte" aria-hidden="true"><span class="pin"></span></div>
      <div class="profil">
        <p class="pr-name">Bar Esempio</p>
        <p class="pr-ort">{de ? 'Café · Agrigento' : 'Bar · Agrigento'}</p>
        <p class="pr-sterne"><b>4,7</b> <span>★★★★★</span> <small>(128)</small></p>
        <p class="pr-offen"><b>{de ? 'Geöffnet' : 'Aperto'}</b> · {de ? 'schließt um 20:00' : 'chiude alle 20:00'}</p>
        <ul class="pr-zeiten">
          <li><span>{de ? 'Mo–Sa' : 'Lun–Sab'}</span><span>07:00–20:00</span></li>
          <li><span>{de ? 'So' : 'Dom'}</span><span>08:00–13:00</span></li>
          <li class="neu"><span>{de ? '8. Dez. (Feiertag)' : '8 dic. (festivo)'}</span><span>08:00–13:00</span><em>{de ? 'aktualisiert' : 'aggiornato'}</em></li>
        </ul>
        <div class="pr-knoepfe"><span>{de ? 'Route' : 'Indicazioni'}</span><span>{de ? 'Anrufen' : 'Chiama'}</span><span>Website</span></div>
        <div class="pr-beitrag"><small>{de ? 'Beitrag · vor 2 Tagen' : 'Post · 2 giorni fa'}</small>{de ? 'Neu: Granita al pistacchio – jeden Morgen frisch.' : 'Novità: granita al pistacchio – fresca ogni mattina.'}</div>
      </div>
      <div class="bericht">
        <p>{de ? 'Monatsbericht' : 'Report mensile'}</p>
        <ul>
          <li><b>1.240</b>{de ? 'Aufrufe' : 'Visualizzazioni'}</li>
          <li><b>36</b>{de ? 'Anrufe' : 'Chiamate'}</li>
          <li><b>88</b>{de ? 'Routen' : 'Indicazioni'}</li>
        </ul>
      </div>
    </div>
  )}

  {slug === 'agendabreve' && (
    <div class="vs-buehne ag">
      <div class="fenster">
        <div class="fenster-leiste"><i></i><i></i><i></i><span>salone-esempio.it/{de ? 'termin' : 'prenota'}</span></div>
        <div class="ag-inhalt">
          <p class="ag-titel">{de ? 'Termin buchen' : 'Prenota un appuntamento'}</p>
          <div class="ag-leistung"><b>{de ? 'Haarschnitt & Föhnen' : 'Taglio e piega'}</b><span>45 Min · 35 €</span></div>
          <div class="ag-tage">{tage.map((t, i) => <span class:list={{ an: i === 2 }}><small>{t}</small>{12 + i}</span>)}</div>
          <div class="ag-zeiten">
            {zeiten.map((z, i) => belegt.has(z)
              ? <span class="ag-z belegt">{z}</span>
              : <><input type="radio" name={`${id}-zeit`} id={`${id}-z${i}`} class="ag-r" checked={z === '10:30'} /><label for={`${id}-z${i}`} class="ag-z">{z}</label></>)}
          </div>
          <span class="ag-knopf">{de ? 'Termin buchen' : 'Prenota'}</span>
        </div>
      </div>
      <div class="ag-bestaetigung">
        <b>{de ? 'Bestätigt' : 'Confermato'}</b>
        <span>{de ? 'Mi, 14. · 10:30 Uhr' : 'Mer 14 · ore 10:30'}</span>
        <small>{de ? 'Erinnerung kommt am Vortag per E-Mail.' : 'Promemoria il giorno prima via e-mail.'}</small>
      </div>
    </div>
  )}

  {slug === 'socialsettimana' && (
    <div class="vs-buehne so">
      {[
        { tag: de ? 'Montag' : 'Lunedì', bild: '/images/vorschau/post-1.webp', text: de ? 'Neue Woche, frische Ideen – der Kaffee steht schon bereit.' : 'Nuova settimana, idee fresche – il caffè è già pronto.', status: 'ok' },
        { tag: de ? 'Mittwoch' : 'Mercoledì', bild: '/images/vorschau/post-2.webp', text: de ? 'Kaffee, Licht und ein ruhiger Platz zum Arbeiten – bis 20 Uhr.' : 'Caffè, luce e un posto tranquillo per lavorare – fino alle 20.', status: 'ok' },
        { tag: de ? 'Freitag' : 'Venerdì', bild: '/images/vorschau/post-3.webp', text: de ? 'Freitagabend: Wir bleiben länger offen. Wer kommt vorbei?' : 'Venerdì sera restiamo aperti più a lungo. Chi passa a trovarci?', status: 'frei' },
      ].map((p) => (
        <div class="post">
          <p class="post-tag">{p.tag}</p>
          <div class="post-bild" style={`background-image:url(${p.bild})`}></div>
          <p class="post-text">{p.text}</p>
          <p class="post-hash">#agrigento #sicilia #caffè</p>
          {p.status === 'ok'
            ? <span class="post-status ok">{de ? 'Freigegeben' : 'Approvato'}</span>
            : <span class="post-status frei">{de ? 'Zur Freigabe' : 'Da approvare'} <b>{de ? 'Freigeben' : 'Approva'}</b></span>}
        </div>
      ))}
    </div>
  )}

  {slug === 'eventolampo' && (
    <div class="vs-buehne ev">
      <div class="handy">
        <div class="handy-insel"></div>
        <div class="ev-seite">
          <div class="ev-kopf">
            <small>{de ? 'Sa, 12. Juni · 19 Uhr' : 'Sab 12 giugno · ore 19'}</small>
            <strong>{de ? 'Sommerfest im Hof' : 'Festa d’estate in cortile'}</strong>
            <span>Aragona · Via Esempio 1</span>
          </div>
          <div class="ev-countdown">
            <span><b>12</b>{de ? 'Tage' : 'giorni'}</span><span><b>06</b>{de ? 'Std' : 'ore'}</span><span><b>45</b>Min</span>
          </div>
          <ul class="ev-programm">
            <li><b>19:00</b>{de ? 'Aperitivo & Live-Musik' : 'Aperitivo e musica dal vivo'}</li>
            <li><b>20:30</b>{de ? 'Buffet mit Spezialitäten' : 'Buffet di specialità'}</li>
            <li><b>22:00</b>{de ? 'Dolci & Tanz' : 'Dolci e balli'}</li>
          </ul>
          <div class="ev-karte" aria-hidden="true"><span></span><b>{de ? 'Anfahrt öffnen' : 'Apri indicazioni'}</b></div>
          <div class="ev-anmeldung"><span>{de ? 'Personen' : 'Persone'} <b>− 2 +</b></span><span class="ev-knopf">{de ? 'Jetzt anmelden' : 'Iscriviti ora'}</span></div>
        </div>
      </div>
      <div class="vs-seite">
        <div class="teilen">
          <div class="teilen-bild"><strong>{de ? 'Sommerfest im Hof' : 'Festa d’estate'}</strong><span>{de ? '12. Juni · Aragona' : '12 giugno · Aragona'}</span></div>
          <p><b>sommerfest-esempio.it</b>{de ? 'Programm, Anfahrt und Anmeldung' : 'Programma, indicazioni e iscrizione'}</p>
        </div>
        <p class="teilen-hinweis">{de ? 'So sieht der Link im Chat aus.' : 'Così appare il link in chat.'}</p>
      </div>
    </div>
  )}

  {slug === 'gareinbreve' && (
    <div class="vs-buehne">
      <div class="fenster gross">
        <div class="fenster-leiste"><i></i><i></i><i></i><span>{de ? 'Posteingang' : 'Posta in arrivo'}</span></div>
        <div class="mail">
          <p class="mail-betreff">{de ? '3 neue Ausschreibungen für Sie · Mi, 12. Nov.' : '3 nuove gare per te · mer 12 nov.'}</p>
          {[
            ['Manutenzione sito web e hosting', 'Comune di Esempio (AG)', '48.000 €', de ? 'Frist 21.11.' : 'Scade 21/11', true, 'CPV 72'],
            ['Fornitura arredi scolastici', 'Istituto Esempio (CL)', '126.500 €', de ? 'Frist 04.12.' : 'Scade 04/12', false, 'CPV 39'],
            ['Servizi di pulizia uffici', 'Ente Esempio (PA)', '92.000 €', de ? 'Frist 15.12.' : 'Scade 15/12', false, 'CPV 90'],
          ].map(([t, e, w, f, eilig, c]) => (
            <div class="gara">
              <div><b>{t}</b><small>{e}</small></div>
              <span class="gara-cpv">{c}</span>
              <span class="gara-wert">{w}</span>
              <span class:list={['gara-frist', { eilig }]}>{f}</span>
            </div>
          ))}
          <p class="mail-fuss">{de ? 'Je Ausschreibung: Kurzfassung und Link zur offiziellen Bekanntmachung.' : 'Per ogni gara: sintesi e link al bando ufficiale.'}</p>
        </div>
      </div>
      <div class="filterkarte">
        <p>{de ? 'Ihr Filter' : 'Il tuo filtro'}</p>
        <span>CPV 72 · 39 · 90</span><span>AG · CL · PA</span><span>40.000–250.000 €</span>
      </div>
    </div>
  )}

  {slug === 'immotesto' && (
    <div class="vs-buehne">
      <div class="daten">
        <p class="daten-titel">{de ? 'Ihre Objektdaten' : 'I tuoi dati'}</p>
        <dl>
          <div><dt>{de ? 'Objekt' : 'Immobile'}</dt><dd>{de ? 'Wohnung, 2. OG' : 'Appartamento, 2° piano'}</dd></div>
          <div><dt>{de ? 'Fläche' : 'Superficie'}</dt><dd>85 m² · 3 {de ? 'Zimmer' : 'vani'}</dd></div>
          <div><dt>{de ? 'Besonders' : 'Punti forti'}</dt><dd>{de ? 'Meerblick, Terrasse 20 m²' : 'Vista mare, terrazzo 20 m²'}</dd></div>
          <div><dt>{de ? 'Ort' : 'Zona'}</dt><dd>San Leone (AG)</dd></div>
          <div><dt>{de ? 'Preis' : 'Prezzo'}</dt><dd>189.000 €</dd></div>
        </dl>
        <span class="warnung">{de ? 'Fehlt: Energieklasse (Pflichtangabe)' : 'Manca: classe energetica (obbligatoria)'}</span>
      </div>
      <div class="expose">
        {(['de', 'it', 'en'] as const).map((s, i) => <input type="radio" name={`${id}-sprache`} id={`${id}-${s}`} class="mv-r" checked={(lang === 'it' ? 1 : 0) === i} />)}
        <div class="ex-tabs">{(['de', 'it', 'en'] as const).map((s) => <label for={`${id}-${s}`} class={`mv-t ex-t-${s}`}>{s.toUpperCase()}</label>)}</div>
        <div class="ex-text ex-de"><b>Wohnung mit Meerblick in San Leone</b><p>Helle 3-Zimmer-Wohnung mit 85 m² im zweiten Stock. Die 20 m² große Terrasse bietet freien Blick aufs Meer – ideal für Frühstück und Sonnenuntergang. Strand und Promenade sind zu Fuß erreichbar.</p></div>
        <div class="ex-text ex-it"><b>Appartamento vista mare a San Leone</b><p>Luminoso trivani di 85 m² al secondo piano. Il terrazzo di 20 m² regala una vista aperta sul mare – perfetto per la colazione e il tramonto. Spiaggia e lungomare raggiungibili a piedi.</p></div>
        <div class="ex-text ex-en"><b>Sea-view apartment in San Leone</b><p>Bright three-room apartment of 85 m² on the second floor. The 20 m² terrace offers an open view of the sea – perfect for breakfast and sunsets. Beach and promenade within walking distance.</p></div>
        <span class="ex-knopf">{de ? 'Text freigeben' : 'Approva il testo'}</span>
      </div>
    </div>
  )}

  {slug === 'replicapro' && (
    <div class="vs-buehne rp">
      <div class="bewertung">
        <p class="bw-kopf"><b>Marco R.</b><span class="sterne">★★★★<em>★</em></span><small>{de ? 'vor 2 Std.' : '2 ore fa'}</small></p>
        <p class="bw-text">„Ottima cena, il pesce freschissimo. Servizio un po’ lento il sabato sera.“</p>
        <div class="entwurf">
          <small>{de ? 'Antwortentwurf · Italienisch (Sprache des Gastes)' : 'Bozza di risposta · in italiano (lingua dell’ospite)'}</small>
          <p>Gentile Marco, grazie per le belle parole sul nostro pesce! Ha ragione sul sabato: abbiamo aggiunto una persona in sala per servirvi più velocemente. A presto!</p>
          <div class="entwurf-knoepfe"><span class="an">{de ? 'Freigeben' : 'Approva'}</span><span>{de ? 'Bearbeiten' : 'Modifica'}</span></div>
        </div>
      </div>
      <div class="hinweis-negativ">
        <b>{de ? 'Neue 2-Sterne-Bewertung' : 'Nuova recensione a 2 stelle'}</b>
        <span>{de ? 'Ruhiger, sachlicher Entwurf liegt bereit.' : 'Una bozza calma e cortese è pronta.'}</span>
      </div>
    </div>
  )}

  {slug === 'betriebsautopilot' && (
    <div class="vs-buehne">
      <div class="kurs">
        <div class="kurs-video"><span class="play"></span><b>{de ? 'Modul 3: Angebote in 10 Minuten' : 'Modulo 3: preventivi in 10 minuti'}</b><small>12:40</small></div>
        <div class="kurs-fortschritt"><span style="width:40%"></span></div>
        <ol class="kurs-liste">
          <li class="fertig">{de ? 'KI-Grundlagen für den Betrieb' : 'Basi di IA per l’azienda'}</li>
          <li class="fertig">{de ? 'E-Mails und Anfragen sortieren' : 'Ordinare e-mail e richieste'}</li>
          <li class="jetzt">{de ? 'Angebote schneller schreiben' : 'Scrivere preventivi più in fretta'}</li>
          <li>{de ? 'Baustellenberichte diktieren' : 'Dettare i rapporti di cantiere'}</li>
          <li>{de ? 'Datenschutz-Check' : 'Controllo privacy'}</li>
        </ol>
      </div>
      <div class="vs-seite">
        <div class="datei"><b>Angebotsvorlage.docx</b><small>{de ? 'Vorlage zum Mitnehmen' : 'Modello da scaricare'}</small></div>
        <div class="ampel">
          <p>{de ? 'Darf das in die KI?' : 'Si può dare all’IA?'}</p>
          <span class="gruen">{de ? 'Leistungsbeschreibung' : 'Descrizione lavori'}</span>
          <span class="gelb">{de ? 'Preise ohne Kundennamen' : 'Prezzi senza nome cliente'}</span>
          <span class="rot">{de ? 'Kundendaten, Steuernummer' : 'Dati cliente, codice fiscale'}</span>
        </div>
      </div>
    </div>
  )}

  {slug === 'vermieterkiste' && (
    <div class="vs-buehne">
      <div class="tabelle">
        <div class="tb-reiter"><span class="an">{de ? 'Belegung' : 'Occupazione'}</span><span>{de ? 'Kurtaxe' : 'Tassa soggiorno'}</span><span>{de ? 'Rechnung' : 'Fattura'}</span></div>
        <div class="tb-raster">
          <span></span>{Array.from({ length: 10 }, (_, i) => <span class="tb-tag">{10 + i}</span>)}
          {[[de ? 'Apt. Mare' : 'App. Mare', [[1, 4, 'a'], [6, 9, 'b']]], [de ? 'Apt. Sole' : 'App. Sole', [[0, 2, 'c'], [3, 8, 'a']]], ['Casa Ulivo', [[2, 6, 'b']]]].map(([n, b]) => (
            <>
              <span class="tb-name">{n as string}</span>
              <div class="tb-zeile">{(b as [number, number, string][]).map(([s, e, k]) => <i class={`tb-b ${k}`} style={`grid-column:${s + 1}/${e + 2}`}></i>)}</div>
            </>
          ))}
        </div>
      </div>
      <div class="rechner">
        <p>{de ? 'Kurtaxe-Rechner' : 'Calcolo tassa di soggiorno'}</p>
        <div><span>{de ? 'Nächte' : 'Notti'}</span><b>4</b></div>
        <div><span>{de ? 'Personen ab 12 J.' : 'Ospiti oltre 12 anni'}</span><b>2</b></div>
        <div><span>{de ? 'Satz je Nacht' : 'Tariffa a notte'}</span><b>2,00 €</b></div>
        <div class="summe"><span>{de ? 'Kurtaxe' : 'Totale'}</span><b>16,00 €</b></div>
      </div>
    </div>
  )}

  {slug === 'sitotranquillo' && (
    <div class="vs-buehne">
      <div class="fenster gross">
        <div class="fenster-leiste"><i></i><i></i><i></i><span>panificio-esempio.it</span></div>
        <div class="seite-mini">
          <div class="sm-hero"><b>Panificio Esempio</b><span>{de ? 'Brot aus dem Holzofen seit 1968' : 'Pane cotto a legna dal 1968'}</span><em>{de ? 'Heute geöffnet bis 13:30' : 'Oggi aperto fino alle 13:30'}</em></div>
          <div class="sm-karten"><span>{de ? 'Unser Brot' : 'Il nostro pane'}</span><span>{de ? 'Öffnungszeiten' : 'Orari'}</span><span>{de ? 'So finden Sie uns' : 'Dove siamo'}</span></div>
        </div>
      </div>
      <div class="chat">
        <p class="chat-a">{de ? 'Bitte über Weihnachten: 24.12. nur bis 12 Uhr.' : 'Per Natale: il 24/12 solo fino alle 12.'}</p>
        <p class="chat-b">{de ? 'Erledigt – ist online.' : 'Fatto – è online.'}<small>{de ? 'nach 2 Std.' : 'dopo 2 ore'}</small></p>
        <span class="chat-hinweis">{de ? 'Änderungen inklusive' : 'Modifiche incluse'}</span>
      </div>
    </div>
  )}

  {slug === 'sitocura' && (
    <div class="vs-buehne">
      <div class="bericht-gross">
        <p class="bg-kopf"><b>{de ? 'Monatsbericht Oktober' : 'Report di ottobre'}</b><span>www.esempio.it</span></p>
        <div class="bg-werte">
          <div><b>14</b><span>{de ? 'Updates' : 'Aggiornamenti'}</span></div>
          <div><b>31</b><span>Backup</span></div>
          <div><b>99,9 %</b><span>{de ? 'erreichbar' : 'online'}</span></div>
          <div><b>0</b><span>{de ? 'Störungen offen' : 'Problemi aperti'}</span></div>
        </div>
        <ul class="bg-liste">
          <li class="ok">{de ? 'Backup vor jedem Update erstellt' : 'Backup prima di ogni aggiornamento'}</li>
          <li class="ok">{de ? 'Sicherheitsprüfung ohne Befund' : 'Controllo sicurezza senza problemi'}</li>
          <li class="pruefen">{de ? 'Zu prüfen: ein Plugin wird nicht mehr gepflegt' : 'Da valutare: un plugin non è più aggiornato'}</li>
        </ul>
      </div>
    </div>
  )}

  {slug === 'bandiinbreve' && (
    <div class="vs-buehne">
      <div class="fenster gross">
        <div class="fenster-leiste"><i></i><i></i><i></i><span>Newsletter · BandiInBreve</span></div>
        <div class="mail">
