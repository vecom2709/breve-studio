---
import Base from '../layouts/Base.astro';
import {
  catalogStats,
  packagesSorted,
  shopCategories,
  type Locale,
  type PackageStatus,
} from '../content/packages';
import { testimonials } from '../content/testimonials';
import { path, ui, formatPrice, locales } from '../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const de = lang === 'de';
const stats = catalogStats();
const all = packagesSorted();
const voice = testimonials[0];
const actionLabel = (status: PackageStatus) => (status === 'inquiry' ? t.inquire : t.reserve);
const actionHref = (slug: string) => `${path('package', lang, slug)}#formular`;
---
<Base lang={lang} routeKey="home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.taglineSmall}</p>
        <h1>
          {de
            ? <>Klare digitale Pakete für Betriebe – <em class="accent">ohne Ballast.</em></>
            : <>Pacchetti digitali chiari per la tua attività – <em class="accent">senza zavorra.</em></>}
        </h1>
        <p class="lead">{t.home.lead}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={path('products', lang)}>{t.discoverProducts} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-outline" href={path('packages', lang)}>{t.seeShowcase}</a>
        </div>
      </div>
      <figure class="hero-photo">
        <picture>
          <source type="image/webp" srcset="/images/home/hero-light.webp" />
          <img src="/images/home/hero-light.jpg" width="1280" height="720" alt={de ? 'Heller Schreibtisch mit Laptop, Pflanze und Tasse' : 'Scrivania chiara con portatile, pianta e tazza'} decoding="async" />
        </picture>
      </figure>
    </div>
  </section>

  <section class="trust" aria-label={de ? 'Grundsätze' : 'Principi'}>
    <div class="wrap trust-grid">
      {t.trustHome.map((item) => (
        <div class="trust-item">
          <p class="tt">{item.title}</p>
          <p class="tx">{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="shop" aria-labelledby="shop-h" data-shop>
    <div class="wrap">
      <div class="sec-head">
        <h2 id="shop-h">{t.productsHeading}</h2>
        <p class="muted">{t.productsLead}</p>
      </div>
      <div class="chips" role="group" aria-label={t.filterLabel}>
        <button type="button" class="chip" data-shop-filter="" aria-pressed="true">{t.filterAll}</button>
        {shopCategories.map((c) => (
          <button type="button" class="chip" data-shop-filter={c.id} aria-pressed="false">{c.label[lang]}</button>
        ))}
      </div>
      <div class="cards">
        {all.map((p) => {
          const price = formatPrice(p.prices[0], lang);
          return (
            <article class="pcard" data-shop-cat={p.shopCategory}>
              <p class="badge" data-status={p.status}>{(p.status === 'waitlist' || p.status === 'inquiry' || p.status === 'soon') ? t.badge[p.status] : t.status[p.status]}</p>
              {p.image && (
                <a class="media" href={path('package', lang, p.slug)} tabindex="-1">
                  <img src={p.image} alt={p.imageAlt?.[lang] ?? ''} width="640" height="360" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="body">
                <h3><a href={path('package', lang, p.slug)}>{p.brand}</a></h3>
                <p>{p.benefit[lang]}</p>
                <p class="price">
                  <span class="plab">{t.plannedPrice}</span>
                  <span class="pamt">{price.main}{price.period ? ` ${price.period}` : ''}</span>
                  {price.vat && <span class="pvat">{price.vat}</span>}
                </p>
                <a class="btn btn-primary" href={actionHref(p.slug)}>{actionLabel(p.status)} <span class="arrow" aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })}
      </div>
      <p class="shop-empty" data-shop-empty hidden>{t.shopEmpty}</p>
    </div>
  </section>

  <section class="stats" aria-label={de ? 'Zahlen, Stand heute' : 'Cifre, stato attuale'}>
    <div class="wrap stats-grid">
      <div><p class="num">{stats.total}</p><p class="lab">{t.statsCatalog}</p></div>
      <div><p class="num">{locales.length}</p><p class="lab">{t.statsLanguages}</p></div>
      <div><p class="num" data-visit-count>0</p><p class="lab">{t.statsVisits}</p></div>
      <div><p class="num">{t.statsSinceValue}</p><p class="lab">{t.statsSince}</p></div>
    </div>
  </section>

  {voice && (
    <section class="voice" aria-labelledby="voice-h">
      <div class="wrap voice-grid">
        <figure class="quote">
          <p class="eyebrow" id="voice-h">{t.testimonialHeading}</p>
          <blockquote>
            <p>„{voice.quote[lang]}“</p>
          </blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{voice.initials}</span>
            <span class="who">
              <strong>{voice.name}</strong>
              {voice.verified && (
                <span class="verified">
                  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#1a5c52"/><path d="M4.4 8.2 6.6 10.4 11.6 5.4" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {t.verifiedCustomer}
                </span>
              )}
              {lang !== voice.originalLocale && <span class="tr">{t.translatedFromDe}</span>}
            </span>
          </figcaption>
        </figure>
        <div class="cta-band">
          <h2>{t.ctaBandTitle}</h2>
          <p>{t.ctaBandBody}</p>
          <p class="cta-row">
            <a class="btn btn-primary" href={path('contact', lang)}>{t.inquire} <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-outline" href={path('packages', lang)}>{t.seeShowcase}</a>
          </p>
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  const shop = document.querySelector<HTMLElement>('[data-shop]');
  if (shop) {
    const chips = [...shop.querySelectorAll<HTMLButtonElement>('[data-shop-filter]')];
    const cards = [...shop.querySelectorAll<HTMLElement>('[data-shop-cat]')];
    const empty = shop.querySelector<HTMLElement>('[data-shop-empty]');
    const apply = (cat: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.shopFilter === cat)));
      let n = 0;
      cards.forEach((el) => {
        const show = !cat || el.dataset.shopCat === cat;
        el.hidden = !show;
        if (show) n++;
      });
      if (empty) empty.hidden = n !== 0;
    };
    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.shopFilter ?? '')));
  }
</script>

<style>
  .hero { padding-block: clamp(2rem, 4vw, 4.5rem); background: #fff; }
  .hero-grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 60rem) { .hero-grid { grid-template-columns: 1fr 1fr; gap: 3.5rem; } }
  .hero h1 { font-size: clamp(2.15rem, 1.2rem + 3.2vw, 3.8rem); max-width: 16ch; color: var(--ink); }
  .hero .lead { margin-top: 1.2rem; color: var(--ink-2); }
  .cta-row { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.6rem; }
  .hero-photo { margin: 0; }
  .hero-photo img { width: 100%; height: auto; border-radius: 18px; object-fit: cover; aspect-ratio: 4 / 3; background: #EEF1EE; }
  .trust { background: #fff; border-block: 1px solid #E6E8E4; padding-block: 1.35rem; }
  .trust-grid { display: grid; gap: 1rem 1.5rem; }
  @media (min-width: 48rem) { .trust-grid { grid-template-columns: repeat(4, 1fr); } }
  .tt { font-family: var(--geo); font-weight: 680; color: var(--forest); }
  .tx { font-size: var(--step--1); color: var(--ink-2); }
  .shop { padding-block: var(--space-xl); }
  .sec-head { text-align: center; max-width: 40rem; margin: 0 auto 1.5rem; display: grid; gap: .6rem; }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; margin-bottom: 1.6rem; }
  .chip { appearance: none; font: 600 var(--step--1)/1.2 var(--sans); color: var(--ink); background: #fff; border: 1px solid #D5DAD6; border-radius: 999px; padding: .5rem 1rem; min-height: 2.4rem; cursor: pointer; }
  .chip:hover { border-color: var(--forest); color: var(--forest); }
  .chip[aria-pressed='true'] { background: var(--forest); border-color: var(--forest); color: #fff; }
  .cards { display: grid; gap: 1.25rem; }
  @media (min-width: 44rem) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 72rem) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .pcard { position: relative; background: #fff; border: 1px solid #E6E8E4; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
  .pcard .badge { position: absolute; top: .8rem; left: .8rem; z-index: 1; margin: 0; background: #fff; color: var(--forest); border: 1px solid #D5DAD6; border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .02em; padding: .25rem .6rem; }
  .pcard .badge[data-status='waitlist'] { color: var(--forest); }
  .pcard .badge[data-status='inquiry'] { background: var(--forest); color: #fff; border-color: var(--forest); }
  .pcard .badge[data-status='soon'] { color: #6B5530; border-color: #D3C4A4; }
  .media img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #EEF1EE; }
  .body { display: grid; gap: .5rem; padding: 1.1rem 1.15rem 1.25rem; flex: 1; }
  .body h3 { font-size: 1.15rem; }
  .body h3 a { text-decoration: none; color: var(--ink); }
  .body h3 a:hover { color: var(--forest); }
  .body p { color: var(--ink-2); font-size: var(--step--1); }
  .price { display: grid; gap: .1rem; }
  .plab { font-size: .75rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .pamt { font-family: var(--geo); font-weight: 700; font-size: 1.15rem; color: var(--ink); }
  .pvat { color: var(--muted); }
  .body .btn { justify-self: start; margin-top: .35rem; min-height: 2.5rem; padding-inline: 1.05rem; font-size: var(--step--1); }
  .shop-empty { text-align: center; margin-top: 1rem; color: var(--ink-2); }
  .cards > :global([hidden]) { display: none !important; }
  .stats { background: #E4EFE9; padding-block: 1.8rem; }
  .stats-grid { display: grid; gap: 1.2rem; text-align: center; }
  @media (min-width: 48rem) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }
  .num { font-family: var(--geo); font-size: clamp(1.8rem, 1.3rem + 1.5vw, 2.5rem); font-weight: 700; color: var(--forest); line-height: 1; }
  .lab { margin-top: .35rem; color: var(--ink-2); font-size: var(--step--1); }
  .voice { padding-block: var(--space-xl); background: #fff; }
  .voice-grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 58rem) { .voice-grid { grid-template-columns: 1.1fr .9fr; gap: 3rem; } }
  blockquote { margin: .8rem 0 1.2rem; }
  blockquote p { font-family: var(--geo); font-size: var(--step-2); font-style: italic; font-weight: 500; letter-spacing: -0.02em; color: var(--ink); }
  figcaption { display: flex; gap: .85rem; align-items: center; }
  .avatar { width: 3rem; height: 3rem; border-radius: 999px; background: var(--forest); color: #fff; display: grid; place-items: center; font-family: var(--geo); font-weight: 700; letter-spacing: .04em; }
  .who { display: grid; gap: .15rem; }
  .verified { display: inline-flex; align-items: center; gap: .3rem; color: var(--forest); font-weight: 650; font-size: var(--step--1); }
  .tr { display: block; font-size: var(--step--1); color: var(--muted); }
  .cta-band { background: #F3F7F5; border-radius: 16px; padding: 1.5rem 1.4rem; display: grid; gap: .7rem; }
  .cta-band h2 { font-size: var(--step-2); }
  .cta-band .cta-row { margin-top: .4rem; }
</style>
