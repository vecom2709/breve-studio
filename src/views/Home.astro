---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  catalogStats,
  packagesSorted,
  shopCategories,
  type Locale,
  type PackageStatus,
} from '../content/packages';
import { testimonials } from '../content/testimonials';
import { homeHero, statusPanel, trustBar, solutionsHead, solutionCards, appTeaser } from '../content/home';
import { path, ui, formatPrice, locales } from '../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const de = lang === 'de';
const stats = catalogStats();
const all = packagesSorted();
const voice = testimonials[0];
const hero = homeHero[lang];
const panel = statusPanel[lang];
const sol = solutionsHead[lang];
const app = appTeaser[lang];
const actionLabel = (status: PackageStatus) => (status === 'inquiry' ? t.inquire : t.reserve);
const actionHref = (slug: string) => `${path('package', lang, slug)}#formular`;
const panelRows = [
  { icon: 'layers', value: stats.total, label: panel.total },
  { icon: 'cog', value: stats.servicesInquiry, label: panel.services },
  { icon: 'flask', value: stats.productsWaitlist, label: panel.products },
  { icon: 'calendar', value: stats.planned, label: panel.planned },
] as const;
const heroImg = `/images/home/hero-${lang}`;
---
<Base lang={lang} routeKey="home">
  <section class="hero" aria-labelledby="hero-h">
    <picture class="hero-bg">
      <source media="(max-width: 39.99rem)" type="image/avif" srcset={`${heroImg}-mobil.avif`} />
      <source media="(max-width: 39.99rem)" type="image/webp" srcset={`${heroImg}-mobil.webp`} />
      <source type="image/avif" srcset={`${heroImg}-1600.avif 1600w, ${heroImg}-2560.avif 2560w, ${heroImg}-3600.avif 3600w`} sizes="100vw" />
      <source type="image/webp" srcset={`${heroImg}-1600.webp 1600w, ${heroImg}-2560.webp 2560w, ${heroImg}-3600.webp 3600w`} sizes="100vw" />
      <img
        src={`${heroImg}-2560.jpg`}
        width="2560"
        height="693"
        alt={de
          ? 'Arbeitsplatz am Abend: Laptop mit der Studio-Breve-Startseite, daneben eine Tasse mit dem goldenen Vecom-V, Schreibtischlampe und Pflanzen'
          : 'Postazione di lavoro la sera: portatile con la home di Studio Breve, accanto una tazza con la V dorata di Vecom, lampada e piante'}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap-wide hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">{hero.eyebrow}</p>
        <h1 id="hero-h">{hero.h1a.map((z) => <span class="h1-z">{z} </span>)}<em class="h1-z">{hero.h1b}</em></h1>
        <p class="hero-lead">{t.home.lead}</p>
        <div class="hero-cta">
          <a class="hbtn hbtn-gold" href={path('packages', lang)}>
            <Icon name="cart" size={22} />
            <span>{hero.ctaPrimary}</span>
            <Icon name="arrow" size={20} class="arrow" />
          </a>
          <a class="hbtn hbtn-line" href={path('contact', lang)}>
            <Icon name="chat" size={21} />
            <span>{hero.ctaSecondary}</span>
          </a>
        </div>
      </div>
      <aside class="status-panel" aria-labelledby="status-h">
        <p class="sp-title" id="status-h"><span class="sp-bars"><Icon name="bars" size={22} stroke={3.2} /></span>{panel.title}</p>
        <ul class="sp-list">
          {panelRows.map((r) => (
            <li>
              <Icon name={r.icon} size={26} stroke={1.9} />
              <span class="sp-num">{r.value}</span>
              <span class="sp-lab">{r.label}</span>
            </li>
          ))}
        </ul>
        <p class="sp-note"><Icon name="info" size={24} stroke={1.7} /><span>{panel.note}</span></p>
      </aside>
    </div>
  </section>

  <section class="trustbar" aria-label={de ? 'Grundsätze' : 'Principi'}>
    <ul class="wrap-wide tb-grid">
      {trustBar[lang].map((item) => (
        <li class="tb-item">
          <Icon name={item.icon} size={40} stroke={1.7} />
          <span class="tb-text"><strong>{item.title}</strong><span>{item.text}</span></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="solutions" aria-labelledby="sol-h">
    <div class="wrap-wide">
      <header class="sol-head">
        <p class="sol-eyebrow">{sol.eyebrow}</p>
        <h2 id="sol-h">{sol.title}</h2>
        <p class="sol-lead">{sol.lead}</p>
      </header>
      <div class="sol-grid">
        {solutionCards.map((c) => {
          const tx = c.text[lang];
          const href = c.route === 'package' ? path('package', lang, c.slug) : path(c.route, lang);
          return (
            <article class="sol-card">
              <div class="sol-top">
                <a class="sol-media" href={href} tabindex="-1" aria-hidden="true">
                  <picture>
                    <source type="image/avif" srcset={`${c.image}.avif`} />
                    <source type="image/webp" srcset={`${c.image}.webp`} />
                    <img src={`${c.image}.jpg`} width="960" height="536" alt="" loading="lazy" decoding="async" />
                  </picture>
                </a>
                <span class="sol-icon"><Icon name={c.icon} size={30} stroke={1.9} /></span>
              </div>
              <div class="sol-body">
                <h3><a href={href}>{tx.title}</a></h3>
                <p>{tx.body}</p>
                <a class="sol-btn" href={href} aria-label={`${tx.cta}: ${tx.title}`}>{tx.cta} <Icon name="arrow" size={18} stroke={2} class="arrow" /></a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="app-teaser" aria-labelledby="app-h">
    <div class="wrap-wide app-grid">
      <figure class="app-phone">
        <picture>
          <source type="image/avif" srcset={`/images/home/app-handy-${lang}.avif`} />
          <source type="image/webp" srcset={`/images/home/app-handy-${lang}.webp`} />
          <img src={`/images/home/app-handy-${lang}.png`} width="1100" height="1300" alt={app.alt} loading="lazy" decoding="async" />
        </picture>
      </figure>
      <div class="app-copy">
        <p class="app-eyebrow"><Icon name="phone" size={18} />{app.eyebrow}</p>
        <h2 id="app-h">{app.title}</h2>
        <p class="app-body">{app.body}</p>
        <ul class="app-points">
          {app.points.map((p) => <li><Icon name="check" size={18} stroke={2.4} />{p}</li>)}
        </ul>
        <a class="hbtn hbtn-gold" href={path('app', lang)}>
          <Icon name="download" size={21} />
          <span>{app.cta}</span>
          <Icon name="arrow" size={20} class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="shop" aria-labelledby="shop-h" data-shop>
    <div class="wrap">
      <div class="sec-head">
        <h2 id="shop-h">{de ? 'Alle Pakete im Überblick' : 'Tutti i pacchetti in sintesi'}</h2>
        <p class="muted">{t.productsLead}</p>
      </div>
      <div class="chips" role="group" aria-label={t.filterLabel}>
        <button type="button" class="chip" data-shop-filter="" aria-pressed="true">{t.filterAll}</button>
        {shopCategories.map((c) => (
          <button type="button" class="chip" data-shop-filter={c.id} aria-pressed="false">{c.label[lang]}</button>
        ))}
      </div>
      <div class="cards">
        {all.map((p) => {
          const price = formatPrice(p.prices[0], lang);
          return (
            <article class="pcard" data-shop-cat={p.shopCategory}>
              <p class="badge" data-status={p.status}>{(p.status === 'waitlist' || p.status === 'inquiry' || p.status === 'soon') ? t.badge[p.status] : t.status[p.status]}</p>
              {p.image && (
                <a class="media" href={path('package', lang, p.slug)} tabindex="-1">
                  <img src={p.image} alt={p.imageAlt?.[lang] ?? ''} width="640" height="360" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="body">
                <h3><a href={path('package', lang, p.slug)}>{p.brand}</a></h3>
                <p>{p.benefit[lang]}</p>
                <p class="price">
                  <span class="plab">{t.plannedPrice}</span>
                  <span class="pamt">{price.main}{price.period ? ` ${price.period}` : ''}</span>
                  {price.vat && <span class="pvat">{price.vat}</span>}
                </p>
                <a class="btn btn-primary" href={actionHref(p.slug)}>{actionLabel(p.status)} <span class="arrow" aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })}
      </div>
      <p class="shop-empty" data-shop-empty hidden>{t.shopEmpty}</p>
    </div>
  </section>

  <section class="stats" aria-label={de ? 'Zahlen, Stand heute' : 'Cifre, stato attuale'}>
    <div class="wrap stats-grid">
      <div><p class="num">{stats.total}</p><p class="lab">{t.statsCatalog}</p></div>
      <div><p class="num">{locales.length}</p><p class="lab">{t.statsLanguages}</p></div>
      <div><p class="num" data-visit-count>0</p><p class="lab">{t.statsVisits}</p></div>
      <div><p class="num">{t.statsSinceValue}</p><p class="lab">{t.statsSince}</p></div>
    </div>
  </section>

  {voice && (
    <section class="voice" aria-labelledby="voice-h">
      <div class="wrap voice-grid">
        <figure class="quote">
          <p class="eyebrow" id="voice-h">{t.testimonialHeading}</p>
          <blockquote>
            <p>„{voice.quote[lang]}“</p>
          </blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{voice.initials}</span>
            <span class="who">
              <strong>{voice.name}</strong>
              {voice.verified && (
                <span class="verified">
                  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#1a5c52"/><path d="M4.4 8.2 6.6 10.4 11.6 5.4" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {t.verifiedCustomer}
                </span>
              )}
              {lang !== voice.originalLocale && <span class="tr">{t.translatedFromDe}</span>}
            </span>
          </figcaption>
        </figure>
        <div class="cta-band">
          <h2>{t.ctaBandTitle}</h2>
          <p>{t.ctaBandBody}</p>
          <p class="cta-row">
            <a class="btn btn-primary" href={path('contact', lang)}>{t.inquire} <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-outline" href={path('packages', lang)}>{t.seeShowcase}</a>
          </p>
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  const shop = document.querySelector<HTMLElement>('[data-shop]');
  if (shop) {
    const chips = [...shop.querySelectorAll<HTMLButtonElement>('[data-shop-filter]')];
    const cards = [...shop.querySelectorAll<HTMLElement>('[data-shop-cat]')];
    const empty = shop.querySelector<HTMLElement>('[data-shop-empty]');
    const apply = (cat: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.shopFilter === cat)));
      let n = 0;
      cards.forEach((el) => {
        const show = !cat || el.dataset.shopCat === cat;
        el.hidden = !show;
        if (show) n++;
      });
      if (empty) empty.hidden = n !== 0;
    };
    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.shopFilter ?? '')));
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: #0a2624; }
  .hero-bg, .hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-bg img { object-fit: cover; object-position: 42% 46%; }
  .hero-shade {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(7, 30, 29, 0.6) 0%, rgba(7, 30, 29, 0.38) 26%, rgba(7, 30, 29, 0) 42%),
      linear-gradient(180deg, rgba(5, 22, 21, 0.18) 0%, rgba(5, 22, 21, 0) 30%, rgba(5, 22, 21, 0) 80%, rgba(5, 22, 21, 0.25) 100%);
  }
  .hero-grid {
    position: relative; z-index: 1; display: grid; align-items: center;
    grid-template-columns: minmax(0, 37rem) minmax(0, 1fr) minmax(19rem, 23.5rem);
    min-height: clamp(25rem, 25vw, 32rem); padding-block: clamp(1.3rem, 1.9vw, 2.2rem);
  }
  .hero-copy { grid-column: 1; }
  .status-panel { grid-column: 3; }
  .hero-eyebrow {
    display: flex; align-items: center; gap: 1rem; margin: 0 0 0.9rem;
    font: 700 0.86rem/1 var(--geo); letter-spacing: 0.16em; text-transform: uppercase; color: #fff;
  }
  .hero-eyebrow::after { content: ''; width: 5.8rem; height: 2px; background: #3ed3a8; border-radius: 2px; }
  .hero h1 {
    font-family: var(--serif); font-weight: 520; font-optical-sizing: auto;
    font-size: clamp(2.45rem, 0.9rem + 3.05vw, 3.85rem); line-height: 1.04; letter-spacing: -0.022em;
    color: #fff; max-width: 17ch; text-wrap: balance; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }
  @media (min-width: 60rem) { .h1-z { display: block; } }
  .hero h1 em { font-style: italic; font-weight: 520; color: #3ed3a8; letter-spacing: -0.02em; }
  .hero-lead { margin-top: 1rem; max-width: 34rem; font-size: clamp(1.02rem, 0.9rem + 0.3vw, 1.18rem); line-height: 1.48; color: rgba(255, 255, 255, 0.94); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 1.1rem; margin-top: 1.25rem; }
  .hbtn {
    display: inline-flex; align-items: center; gap: 0.7rem; min-height: 3.15rem; padding: 0.75rem 1.45rem;
    border-radius: 0.55rem; font: 700 1.06rem/1.1 var(--geo); text-decoration: none; letter-spacing: 0;
    transition: transform .18s cubic-bezier(.16,1,.3,1), box-shadow .18s ease, background-color .18s ease;
  }
  .hbtn :global(.arrow) { transition: transform .18s cubic-bezier(.16,1,.3,1); }
  .hbtn:hover :global(.arrow) { transform: translateX(3px); }
  .hbtn-gold { background: linear-gradient(180deg, #f8d58b 0%, #ecb85d 100%); color: #1b1405; box-shadow: 0 8px 22px rgba(236, 184, 93, 0.22), 0 1px 0 rgba(255,255,255,.55) inset; }
  .hbtn-gold:hover { color: #1b1405; transform: translateY(-1px); box-shadow: 0 12px 28px rgba(236, 184, 93, 0.3), 0 1px 0 rgba(255,255,255,.55) inset; }
  .hbtn-line { color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.85); background: rgba(6, 26, 25, 0.25); }
  .hbtn-line:hover { color: #fff; background: rgba(255, 255, 255, 0.1); }
  .hbtn:focus-visible { box-shadow: 0 0 0 3px #0a2624, 0 0 0 5px #f8d58b; }

  .status-panel {
    justify-self: end; width: 100%; padding: 1.15rem 1.5rem 1.05rem;
    border: 1px solid rgba(62, 211, 168, 0.55); border-radius: 0.9rem;
    background: linear-gradient(180deg, rgba(9, 44, 42, 0.86), rgba(7, 34, 33, 0.9));
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255,255,255,.03) inset;
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  .sp-title { display: flex; align-items: center; gap: 1.1rem; margin: 0 0 0.35rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,.16); font: 700 0.98rem/1 var(--geo); letter-spacing: 0.14em; text-transform: uppercase; }
  .sp-bars { color: #3ed3a8; display: inline-grid; }
  .sp-list { list-style: none; margin: 0; padding: 0; }
  .sp-list li { display: grid; grid-template-columns: 1.7rem 2.6rem 1fr; align-items: center; gap: 0.75rem; min-height: 3.15rem; padding-block: 0.3rem; border-bottom: 1px solid rgba(255,255,255,.14); }
  .sp-list li :global(.ico) { color: #fff; }
  .sp-num { font: 600 2.05rem/1 var(--geo); color: #3ed3a8; text-align: left; font-variant-numeric: tabular-nums; }
  .sp-lab { font: 500 1rem/1.25 var(--geo); color: #fff; }
  .sp-note { display: grid; grid-template-columns: 1.7rem 1fr; gap: 0.75rem; align-items: center; margin-top: 0.85rem; font-size: 0.86rem; line-height: 1.45; color: rgba(255, 255, 255, 0.9); }

  @media (min-width: 78rem) and (max-width: 90rem) { .hero-lead { max-width: 29rem; } }
  @media (max-width: 77.99rem) {
    .hero { display: flex; flex-direction: column; }
    .hero-bg { position: relative; inset: auto; order: 2; aspect-ratio: 2 / 1; height: auto; }
    .hero-bg img { position: absolute; object-position: 58% 72%; }
    .hero-shade { display: none; }
    .hero-grid { display: contents; }
    .hero-copy { order: 1; padding: 2.4rem max(1.25rem, calc((100% - 46rem) / 2)) 1.8rem; background: linear-gradient(180deg, #0b302e, #0a2826); }
    .status-panel { order: 3; position: relative; z-index: 2; width: min(100% - 2.5rem, 30rem); margin: -4rem auto 2rem; justify-self: auto; }
    .hero h1 { max-width: 18ch; }
  }
  @media (max-width: 39.99rem) {
    .hero-bg { aspect-ratio: 5 / 4; }
    .hero-bg img { object-position: 50% 50%; }
    .hero-copy { padding: 2rem 1.25rem 1.6rem; }
    .status-panel { margin-top: -2.8rem; }
  }

  /* ---------- Vorteilsleiste ---------- */
  .trustbar { background: #f6efe4; border-bottom: 1px solid #ebe1d0; }
  .tb-grid { list-style: none; margin-block: 0; padding: 1.15rem 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .tb-item { display: flex; align-items: center; justify-content: center; gap: 1.1rem; padding: 0.35rem 1.2rem; }
  .tb-item + .tb-item { border-left: 1px solid #ddd2bf; }
  .tb-item :global(.ico) { color: #1a7a68; flex: none; }
  .tb-text { display: grid; gap: 0.2rem; line-height: 1.25; }
  .tb-text strong { font: 700 1.05rem/1.25 var(--geo); color: #14241f; letter-spacing: -0.005em; }
  .tb-text span { font-size: 0.95rem; color: #33433e; }
  @media (max-width: 69.99rem) {
    .tb-grid { grid-template-columns: repeat(2, 1fr); row-gap: 0.4rem; }
    .tb-item { justify-content: flex-start; }
    .tb-item:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 36rem) {
    .tb-grid { grid-template-columns: 1fr; padding-block: 0.6rem; }
    .tb-item { border-left: 0 !important; padding: 0.7rem 0.2rem; }
    .tb-item + .tb-item { border-top: 1px solid #e3d8c6; }
    .tb-item :global(.ico) { width: 34px; height: 34px; }
  }

  /* ---------- Lösungen ---------- */
  .solutions { background: #fbf8f2; padding-block: clamp(2rem, 2.6vw, 2.75rem) clamp(3rem, 4vw, 4.5rem); }
  .sol-head { text-align: center; max-width: 46rem; margin: 0 auto clamp(1.3rem, 1.6vw, 1.7rem); display: grid; gap: 0.55rem; }
  .sol-eyebrow { display: flex; align-items: center; justify-content: center; gap: 1.1rem; font: 700 0.84rem/1 var(--geo); letter-spacing: 0.18em; text-transform: uppercase; color: #1a6b5c; }
  .sol-eyebrow::before, .sol-eyebrow::after { content: ''; width: 2.6rem; height: 2px; background: #1a7a68; border-radius: 2px; }
  .sol-head h2 { font-family: var(--serif); font-weight: 540; font-size: clamp(1.9rem, 1.2rem + 1.9vw, 2.6rem); letter-spacing: -0.02em; color: #12211d; line-height: 1.1; }
  .sol-lead { font-size: clamp(1rem, 0.94rem + 0.2vw, 1.1rem); color: #2f3f3a; }
  .sol-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 1.6vw, 1.6rem); }
  .sol-card {
    position: relative; display: flex; flex-direction: column; background: #fff; border-radius: 1rem; overflow: hidden;
    box-shadow: 0 1px 0 rgba(20, 40, 35, 0.04), 0 10px 30px rgba(20, 40, 35, 0.09);
    transition: transform .24s cubic-bezier(.16,1,.3,1), box-shadow .24s cubic-bezier(.16,1,.3,1);
  }
  .sol-card:hover { transform: translateY(-3px); box-shadow: 0 1px 0 rgba(20, 40, 35, 0.04), 0 18px 40px rgba(20, 40, 35, 0.14); }
  .sol-media { display: block; aspect-ratio: 32 / 10; overflow: hidden; background: #0d3532; }
  .sol-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .52s cubic-bezier(.16,1,.3,1); }
  .sol-card:hover .sol-media img { transform: scale(1.04); }
  .sol-top { position: relative; }
  .sol-icon {
    position: absolute; left: 1.4rem; bottom: -2.05rem; z-index: 1; width: 4.1rem; height: 4.1rem; display: grid; place-items: center;
    border-radius: 0.95rem; background: linear-gradient(180deg, #146157, #0d4a42); color: #fff;
    border: 4px solid #fff; box-shadow: 0 8px 18px rgba(13, 74, 66, 0.28);
  }
  .sol-body { display: grid; gap: 0.55rem; align-content: start; padding: 2.5rem 1.6rem 1.5rem; flex: 1; }
  .sol-body h3 { font-family: var(--serif); font-weight: 560; font-size: clamp(1.45rem, 1.2rem + 0.6vw, 1.72rem); letter-spacing: -0.015em; line-height: 1.12; }
  .sol-body h3 a { color: #12211d; text-decoration: none; }
  .sol-body h3 a:hover { color: #0f4a43; }
  .sol-body p { font-size: 0.97rem; line-height: 1.5; color: #33433e; }
  .sol-btn {
    justify-self: start; align-self: end; margin-top: 0.6rem; display: inline-flex; align-items: center; gap: 0.75rem;
    min-height: 2.85rem; padding: 0.6rem 1.5rem; border-radius: 0.45rem; background: #0f4a43; color: #fff;
    font: 700 1rem/1 var(--geo); text-decoration: none; transition: background-color .18s ease;
  }
  .sol-btn:hover { background: #0a3a34; color: #fff; }
  .sol-btn:hover :global(.arrow) { transform: translateX(3px); }
  .sol-btn :global(.arrow) { transition: transform .18s cubic-bezier(.16,1,.3,1); }
  .sol-btn:focus-visible { box-shadow: 0 0 0 3px #fff, 0 0 0 5px #0f4a43; }
