---
import Base from '../layouts/Base.astro';
import type { Locale } from '../content/packages';
import { path, ui } from '../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const c = ui[lang].cartPage;
---
<Base lang={lang} routeKey="cart" title={c.title} description={c.body}>
  <section class="wrap cart">
    <p class="eyebrow">{c.title}</p>
    <h1>{c.empty}</h1>
    <p class="lead">{c.body}</p>
    <p class="cta-row">
      <a class="btn btn-primary" href={path('packages', lang)}>{c.toPackages}</a>
      <a class="btn btn-outline" href={path('contact', lang)}>{c.toContact}</a>
    </p>
  </section>
</Base>
<style>
  .cart { padding-block: var(--space-xl); max-width: 40rem; }
  .cta-row { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.6rem; }
  h1 { margin-top: .8rem; }
  .lead { margin-top: 1rem; }
</style>
