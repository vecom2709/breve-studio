---
import Base from '../layouts/Base.astro';
import type { Locale } from '../content/packages';
import { path, ui } from '../lib/i18n';
import { site } from '../content/site';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang].appPage;
const startUrl = new URL(path('home', lang), site.url).href;
const qr = lang === 'de' ? '/images/app/qr-de.svg' : '/images/app/qr-it.svg';
---
<Base lang={lang} routeKey="app" title={t.title} description={t.description}>
  <section class="wrap app">
    <p class="eyebrow">{site.name}</p>
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <div class="grid">
      <article>
        <h2>{t.androidTitle}</h2>
        <p>{t.androidBody}</p>
        <p>
          <button type="button" class="btn btn-primary" data-install hidden>{ui[lang].appPage.installButton}</button>
        </p>
        <p class="hint" data-install-hint hidden>{t.installUnavailable}</p>
        <p class="ok" data-installed hidden>{t.installed}</p>
      </article>
      <article>
        <h2>{t.iosTitle}</h2>
        <p>{t.iosBody}</p>
      </article>
      <figure class="qr">
        <h2>{t.qrTitle}</h2>
        <img src={qr} width="220" height="220" alt={t.qrCaption} />
        <figcaption>
          <p>{t.qrCaption}</p>
          <p class="note">{t.qrNote}</p>
          <p class="url">{startUrl}</p>
        </figcaption>
      </figure>
    </div>
    <p class="back"><a href={path('home', lang)}>{t.back}</a></p>
  </section>
</Base>
<script is:inline>
  (function () {
    var btn = document.querySelector('[data-install]');
    var hint = document.querySelector('[data-install-hint]');
    var done = document.querySelector('[data-installed]');
    if (!btn) return;
    var deferred = null;
    var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    if (standalone && done) { done.hidden = false; return; }
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferred = e;
      btn.hidden = false;
      if (hint) hint.hidden = true;
    });
    btn.addEventListener('click', function () {
      if (!deferred) return;
      deferred.prompt();
      deferred.userChoice.finally(function () { deferred = null; btn.hidden = true; });
    });
    window.addEventListener('appinstalled', function () {
      if (done) done.hidden = false;
      btn.hidden = true;
    });
    if (hint) {
      setTimeout(function () { if (btn.hidden && !standalone) hint.hidden = false; }, 1200);
    }
  })();
</script>
<style>
  .app { padding-block: var(--space-xl) var(--space-l); max-width: 52rem; }
  .app h1 { margin-top: .8rem; max-width: 16em; }
  .lead { margin-top: 1rem; color: var(--ink-2); max-width: 42em; }
  .grid { display: grid; gap: 1.25rem; margin-top: 2rem; }
  @media (min-width: 52rem) { .grid { grid-template-columns: 1fr 1fr; } .qr { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr; gap: 1.25rem 1.75rem; align-items: center; } }
  article, .qr { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 1.25rem 1.3rem; }
  article h2, .qr h2 { font-size: var(--step-2); margin: 0 0 .6rem; }
  .qr { margin: 0; }
  .qr img { width: 11rem; height: 11rem; background: #fff; border-radius: 8px; }
  .qr .url { font-size: var(--step--1); color: var(--forest); word-break: break-all; }
  .note, .hint { font-size: var(--step--1); color: var(--ink-2); }
  .ok { color: var(--forest); font-weight: 650; }
  .back { margin-top: 2rem; }
  .back a { font-weight: 650; color: var(--forest); }
</style>
