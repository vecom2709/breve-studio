---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/outfit';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracker from '../components/Tracker.astro';
import SearchPanel from '../components/SearchPanel.astro';
import { site } from '../content/site';
import type { Locale } from '../content/packages';
import {
  path,
  otherLocales,
  ui,
  locales,
  localeConfig,
  langStorageKey,
  type RouteKey,
} from '../lib/i18n';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  routeKey: RouteKey;
  slug?: string;
  image?: string;
  /** z. B. 404 ohne sinnvolle alternative URL je Sprache */
  altHref?: string;
  /** Sprache in localStorage merken (Standard: ja; nicht auf der 404) */
  persistLang?: boolean;
}
const {
  lang,
  title,
  description,
  routeKey,
  slug,
  image,
  altHref: altOverride,
  persistLang = true,
} = Astro.props;
const selfPath = path(routeKey, lang, slug);
const alternates = otherLocales(lang).map((l) => ({
  lang: l,
  href: altOverride ?? path(routeKey, l, slug),
}));
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} – ${site.tagline[lang]}`;
const desc = description ?? site.description[lang];
const ogImage = new URL(image ?? '/og-studio-breve.jpg', site.url).href;
const canonical = new URL(selfPath, site.url).href;
const xDefault = new URL('/', site.url).href;
const meta = localeConfig[lang];
---
<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <!-- Entwurf: keine Indexierung bis zum offiziellen Start -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    {!altOverride && locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(path(routeKey, l, slug), site.url).href} />
    ))}
    {!altOverride && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f3b33" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.ogLocale} />
    {otherLocales(lang).map((l) => (
      <meta property="og:locale:alternate" content={localeConfig[l].ogLocale} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    {persistLang && (
      <script is:inline define:vars={{ lang, langStorageKey }}>
        try { localStorage.setItem(langStorageKey, lang); } catch {}
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{ui[lang].skip}</a>
    <Header lang={lang} routeKey={routeKey} alternates={alternates} />
    <SearchPanel lang={lang} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
    <Tracker lang={lang} />
  </body>
</html>
