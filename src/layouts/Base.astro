---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
import type { Locale } from '../content/packages';
import { path, other, ui, type RouteKey } from '../lib/i18n';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  routeKey: RouteKey;
  slug?: string;
  image?: string;
  /** z. B. 404 ohne sinnvolle Alternative */
  altHref?: string;
}
const { lang, title, description, routeKey, slug, image, altHref: altOverride } = Astro.props;
const o = other(lang);
const selfPath = path(routeKey, lang, slug);
const altHref = altOverride ?? path(routeKey, o, slug);
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} – ${site.tagline[lang]}`;
const desc = description ?? site.description[lang];
const ogImage = new URL(image ?? '/og-studio-breve.jpg', site.url).href;
const canonical = new URL(selfPath, site.url).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <!-- Entwurf: keine Indexierung bis zum offiziellen Start -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {!altOverride && <link rel="alternate" hreflang={o} href={new URL(altHref, site.url).href} />}
    {!altOverride && <link rel="alternate" hreflang="x-default" href={new URL(path(routeKey, 'de', slug), site.url).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F6F1E8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'it_IT'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'it_IT' : 'de_DE'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{ui[lang].skip}</a>
    <Header lang={lang} routeKey={routeKey} altHref={altHref} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} altHref={altHref} />
  </body>
</html>
