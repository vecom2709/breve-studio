---
import Base from './Base.astro';
import type { Locale } from '../content/packages';
import type { RouteKey } from '../lib/i18n';
import { site } from '../content/site';
interface Props { lang: Locale; routeKey: RouteKey; title: string; description: string }
const { lang, routeKey, title, description } = Astro.props;
const de = lang === 'de';
---
<Base lang={lang} routeKey={routeKey} title={title} description={description}>
  <article class="wrap legal">
    <header>
      <p class="eyebrow">{de ? 'Rechtliches' : 'Informazioni legali'}</p>
      <h1>{title}</h1>
      <p class="draftbox" role="note">{de
        ? `Entwurf, Stand ${site.legalUpdated}. Die Website ist nicht veröffentlicht. Dieser Text wird vor dem Start vervollständigt und rechtlich geprüft; Platzhalter sind in eckigen Klammern markiert.`
        : `Bozza aggiornata al ${site.legalUpdated}. Il sito non è pubblicato. Il testo sarà completato e verificato da un professionista prima del lancio; i dati mancanti sono indicati tra parentesi quadre.`}</p>
    </header>
    <div class="prose"><slot /></div>
  </article>
</Base>
<style>
  .legal { padding-block: var(--space-xl); max-width: 46rem; }
  header { display: grid; gap: 1rem; margin-bottom: var(--space-l); }
  h1 { font-size: var(--step-4); font-weight: 390; }
  .draftbox { border: 1px dashed var(--line-strong); border-radius: var(--radius); padding: .85rem 1.1rem; font-size: var(--step--1); color: var(--ink-2); background: var(--paper-2); }
  .prose :global(h2) { font-size: var(--step-2); margin: 2.4rem 0 .8rem; }
  .prose :global(h3) { font-size: var(--step-1); margin: 1.6rem 0 .5rem; }
  .prose :global(p), .prose :global(ul), .prose :global(address) { margin: 0 0 1rem; color: var(--ink-2); }
  .prose :global(address) { font-style: normal; }
  .prose :global(ul) { padding-left: 1.2rem; }
  .prose :global(li) { margin-bottom: .4rem; }
  .prose :global(strong) { color: var(--ink); }
</style>
