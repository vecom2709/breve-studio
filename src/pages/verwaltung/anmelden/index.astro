---
export const prerender = false;
import AdminPwField from '../../../components/AdminPwField.astro';
import { isAuthed, needsSetup } from '../../../lib/admin-auth';

if (needsSetup()) return Astro.redirect('/verwaltung/');
if (isAuthed(Astro.request)) return Astro.redirect('/verwaltung/');

const err = Astro.url.searchParams.get('fehler') === '1';
const locked = Astro.url.searchParams.get('sperre') === '1';
const restRaw = Astro.url.searchParams.get('rest');
const rest = restRaw != null && /^\d+$/.test(restRaw) ? Number(restRaw) : null;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Anmeldung — Verwaltung</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    :root { color-scheme: light; font-family: "Source Sans 3", system-ui, sans-serif; --forest:#0f3b33; --ink:#14221f; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #F7F8F6; color: var(--ink); padding: 1.5rem; }
    .card { width: min(26rem, 100%); background: #fff; border: 1px solid #d7ddd9; border-radius: 18px; padding: 2rem 1.8rem 1.6rem; display: grid; gap: 1rem; box-shadow: 0 10px 30px rgba(15,59,51,.06); }
    .brand { display: flex; align-items: center; gap: .75rem; text-decoration: none; color: inherit; }
    .brand img { width: 44px; height: 44px; }
    .brand strong { font: 650 1.15rem/1.2 Outfit, "Source Sans 3", system-ui, sans-serif; }
    .brand span { display: block; font-size: .8rem; color: #4a5b56; font-weight: 500; margin-top: .15rem; }
    h1 { font: 650 1.45rem/1.2 Outfit, system-ui, sans-serif; margin: .4rem 0 0; }
    p { margin: 0; color: #4a5b56; }
    button[type=submit] { font: 650 1rem/1 inherit; background: var(--forest); color: #fff; border: 0; border-radius: 999px; padding: .9rem 1.2rem; cursor: pointer; }
    button[type=submit]:hover { background: #164a40; }
    .err { color: #7a1515; background: #fdecec; border: 1px solid #f0c4c4; border-radius: 10px; padding: .8rem .9rem; }
    .err strong { display: block; margin-bottom: .2rem; }
    .back { justify-self: start; color: var(--forest); font-weight: 600; text-decoration: none; font-size: .95rem; }
    .back:hover { text-decoration: underline; }
    form { display: grid; gap: .85rem; margin: 0; }
  </style>
</head>
<body>
  <div class="card">
    <a class="brand" href="/de/">
      <img src="/logo-studio-breve.svg" width="44" height="44" alt="" />
      <span><strong>Studio Breve</strong><span>Digitalstudio · Aragona, Sizilien</span></span>
    </a>
    <h1>Anmeldung zur Verwaltung</h1>
    <p>Geschützter Bereich für den Betreiber. Der Link steht dezent im Fußbereich der Website.</p>
    {locked && (
      <p class="err" role="alert">
        <strong>Zu viele Versuche.</strong>
        Bitte in 15 Minuten erneut versuchen.
      </p>
    )}
    {err && !locked && (
      <p class="err" role="alert">
        <strong>Passwort falsch</strong>
        {rest != null
          ? (rest > 0 ? `Noch ${rest} ${rest === 1 ? 'Versuch' : 'Versuche'}.` : 'Keine Versuche mehr. Bitte in 15 Minuten erneut versuchen.')
          : 'Bitte prüfen Sie die Eingabe und versuchen Sie es erneut.'}
      </p>
    )}
    <form method="post" action="/api/verwaltung/login/">
      <AdminPwField id="password" name="password" label="Passwort" autocomplete="current-password" autofocus={true} />
      <button type="submit">Anmelden</button>
    </form>
    <a class="back" href="/de/">← Zurück zur Website</a>
  </div>
</body>
</html>
