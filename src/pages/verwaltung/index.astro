---
export const prerender = false;
import { isAuthed, needsSetup } from '../../lib/admin-auth';
import AdminSetup from '../../views/AdminSetup.astro';
import AdminDashboard from '../../views/AdminDashboard.astro';

const setup = needsSetup();
if (!setup && !isAuthed(Astro.request)) return Astro.redirect('/verwaltung/anmelden/');
const fehler = Astro.url.searchParams.get('fehler');
---
{setup ? <AdminSetup fehler={fehler} /> : <AdminDashboard />}
